#!/bin/sh
# Renders /boot/loader/entries into a GRUB menu, because no deb GRUB can read
# them itself: `blscfg` is Fedora's command and `blsuki.mod` ships as a module
# the signed image does not carry and cannot load, since Secure Boot prohibits
# loading any module at all.
#
# Written to custom.cfg, the extension point bootupd's own static config
# already sources, so nothing here fights bootupd for grub.cfg. Entries are
# ordered by BLS sort-key, which is what decides the default: bootc gives the
# newest deployment the lowest one.
#
# POSIX shell and `sort`, deliberately: the deb families' default awk is mawk,
# which has neither ENDFILE nor the escapes a menu needs quoting with.
# Takes an optional root: the units pass none and render this machine's own
# /boot, and an installer passes the target it still has mounted, because
# nothing renders the menu during an install — bootupd runs before the entries
# are written. The paths *inside* the menu are the BLS entry's own and are
# absolute against the filesystem GRUB reads, so a prefix here never reaches
# them.
set -eu

root="${1:-}"
entries="${root}/boot/loader/entries"
staged="${root}/boot/loader/entries.staged"
grubdir="${root}/boot/grub2"
out="${grubdir}/custom.cfg"

# **`bootc upgrade` never writes to `loader/entries`.** It writes the next
# boot's menu to `loader/entries.staged` and starts
# `bootc-finalize-staged.service`, whose `ExecStop` renames the one over the
# other at *shutdown* — `bootc_composefs/boot.rs:901`, "This will be atomically
# renamed to 'loader/entries' on shutdown/reboot", and `service.rs:13` for the
# `systemctl start` that arms it. So GRUB reads a menu rendered from the
# *previous* entries on the way back up, and the machine boots the old
# deployment while looking perfectly healthy.
#
# Measured 2026-09-04: an upgrade landed, the reboot took the old deployment,
# and across that whole boot the renderer had run exactly once — at startup,
# before bootc wrote anything. A `.path` unit on `loader/entries` cannot win
# that race; there is nothing to watch until it is too late to matter.
#
# Rendering from the staged directory closes it, and is exact rather than a
# guess: the same code writes *both* entries there, the new deployment at
# `FILENAME_PRIORITY_PRIMARY` and the currently booted one at `SECONDARY`, so it
# is the whole of the next menu and not a fragment of it.
#
# A cancelled upgrade needs nothing special. `update.rs:82` removes the staged
# directory, the `.path` unit sees that removal like any other change, and this
# falls back to `entries` on the next render.
if [ -d "$staged" ]; then
	for conf in "$staged"/*.conf; do
		if [ -f "$conf" ]; then
			entries="$staged"
		fi
		break
	done
fi

[ -d "$entries" ] || exit 0
[ -d "$grubdir" ] || exit 0

# `/boot` is mounted read-only on an installed machine: bootc's own installer
# writes `systemd.mount-extra=UUID=…:/boot:auto:ro` onto the kernel command
# line, and `systemd-fstab-generator` turns that into `boot.mount` with
# `Options=ro`. Measured 2026-09-04 — without this the service failed on every
# boot with `cannot create /boot/grub2/custom.cfg.new: Read-only file system`,
# and the menu stood only because the installer had rendered it once.
#
# This is bootc's own pattern, not an invention: `utils.rs::open_dir_remount_rw`
# guards on `is_mountpoint` and then runs `mount -o remount,rw`, and
# `install.rs` calls it on `/boot`. The guard is the part that matters. A disk
# written by `bootc install to-disk` keeps /boot *inside* the root filesystem,
# where it is not a mountpoint at all — remounting there would remount the
# **root filesystem** read-write, which is emphatically not what this wants.
#
# Only for this machine's own /boot. An installer passes a root and has the
# target mounted writable already, so it neither needs this nor should reach
# for the host's mount table.
#
# Put back afterwards, on success or failure, and only if this changed it —
# bootc leaves /boot writable after its own remount, and a menu renderer is not
# the thing that should quietly make that permanent on every boot.
#
# **`bind` on both, and it is load-bearing rather than tidiness.** Since
# `sysroot-boot-rw.service` there are *two* mounts of this one filesystem —
# `/boot` read-only and `/sysroot/boot` writable — and a plain
# `mount -o remount,ro /boot` changes the **superblock**, which would take
# `/sysroot/boot` read-only with it and break the next `bootc upgrade`.
# `remount,bind,` sets the flag on this mount alone and never touches the
# superblock, which that service has already left writable.
if [ -z "$root" ] && mountpoint -q /boot \
	&& findmnt -no OPTIONS /boot | grep -q '^ro\(,\|$\)'; then
	mount -o remount,bind,rw /boot
	trap 'mount -o remount,bind,ro /boot 2>/dev/null || :' EXIT INT TERM
fi

fields() {
	for conf in "$entries"/*.conf; do
		[ -f "$conf" ] || continue
		title=''
		kernel=''
		initrd=''
		options=''
		sort_key=''
		while read -r key value; do
			case "$key" in
				title) title="$value" ;;
				linux) kernel="$value" ;;
				initrd) initrd="$value" ;;
				options) options="$value" ;;
				sort-key) sort_key="$value" ;;
			esac
		done <"$conf"
		# An entry with no kernel is not one; skipping it is what keeps a
		# half-written file from emptying the menu.
		[ -n "$kernel" ] || continue
		printf '%s\t%s\t%s\t%s\t%s\n' \
			"${sort_key:-${conf##*/}}" "${title:-${conf##*/}}" \
			"$kernel" "$initrd" "$options"
	done | sort
}

tmp="${out}.new"
: >"$tmp"
n=0
fields | while IFS="$(printf '\t')" read -r _ title kernel initrd options; do
	# `if`, not `&&`: a false test ends an AND-list non-zero, and `set -e`
	# would take that as the whole render failing on the second entry.
	if [ "$n" -eq 0 ]; then
		printf "set default='bls-0'\n" >>"$tmp"
	fi
	printf "menuentry '%s' --id 'bls-%s' {\n" "$title" "$n" >>"$tmp"
	printf '  linux %s %s\n' "$kernel" "$options" >>"$tmp"
	if [ -n "$initrd" ]; then
		printf '  initrd %s\n' "$initrd" >>"$tmp"
	fi
	printf '}\n' >>"$tmp"
	n=$((n + 1))
done

if [ ! -s "$tmp" ]; then
	rm -f "$tmp"
	echo "no usable BLS entry under ${entries}" >&2
	exit 1
fi
mv -f "$tmp" "$out"
