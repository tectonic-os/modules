description "Everything a deb-family container image is missing before it is a bootc image: a kernel, dracut, ostree, bootc itself, an initramfs that carries it, and an ostree-shaped root filesystem"

supports "debian" "ubuntu"

provides "bootc-base"

provides-file "/usr/bin/bootc"
provides-file "/usr/bin/bootupctl"
provides-file "/usr/lib/sysimage/dpkg"
// Installed here and enabled by `login-access`, which requires this path.
provides-file "/usr/sbin/sshd"

requires "build-environment"

// bootc opens its composefs image store by running `podman images` in it, so
// the *installed* machine needs a container runtime and not just the builder.
// Declared here rather than folded into this module's package list, because it
// is bootc's dependency and a repository should be told about it by `check`
// before it builds. See `deb-bootc-base/podman` for the measurement.
requires "container-runtime"

// Deliberately *not* `provides "initramfs-generation"`, though this module does
// regenerate one. Two reasons, both measured. `ghcr.io/bootcrew/debian-bootc`
// declares it on its base row, so a module declaring it too is covered "in
// part" and `graph.rs` makes that an error — it turned the `collection debian`
// leg red at `generate`, which is a leg that had been green on every pull
// request. And the ordering would be backwards anyway: dracut runs in this
// module's `finalize.sh`, hooks run in build order, so a module that
// `requires` the capability would have its own finalize hook run *after* the
// initramfs was built rather than before.

// Neither family packages `bootc`, so it is built here. Both halves of the
// release are pinned: the source and the vendored dependencies its `.cargo`
// config replaces crates.io with, so the compile reaches no network and every
// byte of it is held to a hash. `make bin` builds the workspace, xtask
// included, so the toolchain has to satisfy xtask's rust-version and not just
// the library's.
asset "bootc" {
    pin {
        renovate datasource="github-releases" depName="bootc-dev/bootc"
        version "1.16.10"
        url "https://github.com/bootc-dev/bootc/releases/download/v{version}/bootc-{version}.tar.zstd"
        sha256 "1819e7bafabc26d0cbf544a94515c17eccfea449ea780527dc8b3d766f49de46"
    }
}

asset "bootc-vendor" {
    pin {
        renovate datasource="github-releases" depName="bootc-dev/bootc"
        version "1.16.10"
        url "https://github.com/bootc-dev/bootc/releases/download/v{version}/bootc-{version}-vendor.tar.zstd"
        sha256 "79185625d2a44f5e209155cdd1db7a81d3058decaaf6b32453688263f821d400"
    }
}

// `bootupd` is the only thing `bootc install` will install GRUB with — every
// other arm either routes through it or writes systemd-boot — and neither
// family packages it any more than they package `bootc`. Same two-pin shape as
// above: the `.crate` is the released source and the vendor tarball is every
// dependency, so the compile reaches no network and every byte is held to a
// hash.
asset "bootupd" {
    pin {
        renovate datasource="github-releases" depName="coreos/bootupd"
        version "0.3.1"
        url "https://github.com/coreos/bootupd/releases/download/v{version}/bootupd-{version}.crate"
        sha256 "335ac06a450d59f4154a81ed96186e6296c799a584cfa3c3916c7a0023498c38"
    }
}

asset "bootupd-vendor" {
    pin {
        renovate datasource="github-releases" depName="coreos/bootupd"
        version "0.3.1"
        url "https://github.com/coreos/bootupd/releases/download/v{version}/bootupd-{version}-vendor.tar.zstd"
        sha256 "b9348f75a7c94f727e3a7bf2487113348431ea69c6d757ec3edcd626c0cb8576"
    }
}

// `bootc install` needs the ostree CLI and nothing else — measured, not
// assumed: `podman` is not required and the base's own `skopeo` is what bootc
// 1.16 shells out to. The rest is what a container image lacks and a machine
// needs to come up: one kernel, its firmware, the boot chain, and the
// filesystem tools `bootc install to-disk` partitions with. `curl` is here
// because the collection's own `fetch-helpers.sh` runs on it and neither base
// container image ships it, so any deb module with an `asset` needs it first.
// `man-db` is here for `tect validate-image`: `systemd-analyze verify` renders
// every `Documentation=man:` a unit declares, and with no man reader in the
// image it fails the unit rather than skipping the page. `openssh-server` is
// how anyone reaches a machine installed from this base at all, `sudo` is how
// they become root on it, and `less` is what `journalctl` pages through.
//
// `iproute2` is not a convenience. Neither deb base ships it, so `ip` did not
// exist on any machine installed from here — which is how a machine with no
// address at all went unnoticed until `bootc upgrade` answered `failure in
// name resolution` on 2026-09-04 and there was nothing to diagnose it with.
// The fix for the address itself is `89-ethernet.network` and the
// `systemd-networkd` line in this module's preset; this is what makes the next
// one visible.
//
// The schema takes one family per line, so the two lists are repeated rather
// than shared, and they differ in exactly two entries. Ubuntu resolves every
// other name unchanged; it packages no `linux-image-amd64` and no
// `firmware-linux-free`. `linux-image-generic` is the metapackage that tracks
// its kernel, and `linux-firmware-minimal` is the **nearest** firmware match
// rather than an equivalent one — it carried the qemu boot this base was
// proved by on 2026-09-03 and nothing has yet compared what it holds against
// Debian's on hardware.
packages {
    debian "linux-image-amd64" "firmware-linux-free" \
           "dracut" "ostree" "composefs" \
           "systemd-boot" "systemd-boot-efi" \
           "shim-signed" "grub-efi-amd64-signed" "grub-common" \
           "systemd-resolved" "libnss-resolve" "libnss-myhostname" \
           "iproute2" \
           "skopeo" "ca-certificates" "zstd" "curl" \
           "btrfs-progs" "xfsprogs" "e2fsprogs" "dosfstools" "fdisk" \
           "efibootmgr" "cryptsetup-bin" "dmsetup" \
           "openssh-server" "sudo" "less" "man-db"
    ubuntu "linux-image-generic" "linux-firmware-minimal" \
           "dracut" "ostree" "composefs" \
           "systemd-boot" "systemd-boot-efi" \
           "shim-signed" "grub-efi-amd64-signed" "grub-common" \
           "systemd-resolved" "libnss-resolve" "libnss-myhostname" \
           "iproute2" \
           "skopeo" "ca-certificates" "zstd" "curl" \
           "btrfs-progs" "xfsprogs" "e2fsprogs" "dosfstools" "fdisk" \
           "efibootmgr" "cryptsetup-bin" "dmsetup" \
           "openssh-server" "sudo" "less" "man-db"
}

fragment position="after"
