description "VSCodium, the telemetry-free VS Code build"

supports "fedora" "debian" "ubuntu"

requires "build-environment"

family "fedora" {
    // hardened-malloc is a secureblue COPR package and has no deb analogue,
    // so the wrapper `fedora/module.sh` writes has nothing to order against
    // on either deb family.
    after "hardened-malloc"

    packages "codium" enablerepo="vscodium"
}

family "debian" "ubuntu" { packages "codium" }
