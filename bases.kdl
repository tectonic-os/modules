// Bases this collection describes that the tool's own catalog does not, merged
// into the picker by `tect create` for anyone whose repo.kdl lists this
// collection. One entry per image; the tool's row wins where both describe one.

// The tool's catalog names `docker.io/library/debian:trixie` for this, and
// trixie cannot do it — measured 2026-09-01. Every `bootc` carrying
// `--composefs-backend`, which is what reaches a bootloader on a base with no
// `bootupd`, needs libostree >= 2025.3 from its `ostree-ext` crate; trixie
// ships 2025.2 and neither backports nor proposed-updates has more. forky is
// the first Debian with 2026.4, and it carries the package database the whole
// build-rather-than-derive decision rests on: 244 records against 480 binaries
// on the image this collection builds from it, where every published deb bootc
// base has 0.
//
// It is testing rather than stable, and the one thing that costs is
// `VERSION_ID`, which Debian omits from os-release until release: the image
// builder refuses a disk without it, so this base is `bootc install` only.
// That resolves when forky becomes Debian 14 and nothing here has to move.
base "docker.io/library/debian:forky" {
    about "Debian 14, which the debian-bootc-base module set turns into a bootc image"
    family "debian"
    requires "bootc-base"
    signed #false
}
